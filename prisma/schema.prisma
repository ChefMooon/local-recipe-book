generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("LOCAL_RECIPE_BOOK_DATABASE_URL")
}

model Meal {
  id                   String              @id @default(cuid())
  name                 String
  date                 DateTime?           @default(now())
  mealType             String
  mealTypeDefinitionId String?
  mealTypeDefinition   MealTypeDefinition? @relation(fields: [mealTypeDefinitionId], references: [id], onDelete: SetNull)
  mealSubTypeDefinitionId String?
  mealSubTypeDefinition   MealSubTypeDefinition? @relation(fields: [mealSubTypeDefinitionId], references: [id], onDelete: SetNull)
  notes                String?
  ingredientsJson      String              @default("[]")
  description          String?
  instructionsJson     String              @default("[]")
  sortOrder            Int                 @default(0)
  servings             Int                 @default(2)
  prepTime             Int?
  cookTime             Int?
  cuisine              String?
  servingsOverride     Int?
  recipeId             String?
  photoDataUrl         String?
  photoPath            String?
  photoMimeType        String?
  photoFileName        String?
  recipe               Recipe?             @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())

  @@index([date])
  @@index([date, mealType, sortOrder])
  @@index([mealTypeDefinitionId])
  @@index([mealSubTypeDefinitionId])
  @@index([cuisine])
  @@index([recipeId])
}

model MealSubTypeDefinition {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  color     String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  meals     Meal[]

  @@unique([sortOrder])
  @@index([sortOrder])
}

model MealTypeProfile {
  id          String               @id @default(cuid())
  name        String
  color       String               @default("#3B5E45")
  description String?
  isDefault   Boolean              @default(false)
  priority    Int                  @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  mealTypes   MealTypeDefinition[]

  @@index([isDefault, priority])
  @@index([startDate, endDate, priority])
}

model MealTypeDefinition {
  id         String          @id @default(cuid())
  profileId  String
  name       String
  slug       String
  color      String
  enabled    Boolean         @default(true)
  sortOrder  Int             @default(0)
  cutoffTime String?         @default("23:59")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  profile    MealTypeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  meals      Meal[]

  @@unique([profileId, slug])
  @@unique([profileId, sortOrder])
  @@index([profileId, sortOrder])
}

model GroceryList {
  id         String        @id @default(cuid())
  name       String
  date       DateTime?     @default(now())
  favourite  Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  items      GroceryItem[]

  @@index([date])
}

model GroceryItem {
  id            String      @id @default(cuid())
  groceryListId String
  name          String
  qty           String?
  unit          String?
  category      String      @default("Other")
  notes         String?
  meal          String?
  checked       Boolean     @default(false)
  sortOrder     Int         @default(0)
  groceryList   GroceryList @relation(fields: [groceryListId], references: [id], onDelete: Cascade)

  @@index([groceryListId, sortOrder])
}

model PrepList {
  id                     String     @id @default(cuid())
  name                   String
  notes                  String?
  date                   DateTime?
  fromDate               DateTime?
  toDate                 DateTime?
  sourceMode             String     @default("manual")
  sourceLabel            String?
  sourceMealIdsJson      String     @default("[]")
  sourceRecipeIdsJson    String     @default("[]")
  favourite              Boolean    @default(false)
  sortMode               String     @default("manual")
  groupBy                String     @default("dish")
  includeIngredients     Boolean    @default(true)
  includeTasks           Boolean    @default(true)
  includeQuantities      Boolean    @default(true)
  includeIngredientTypes Boolean    @default(true)
  includeSourceLabels    Boolean    @default(true)
  excludePantryStaples   Boolean    @default(false)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  items                  PrepItem[]

  @@index([date])
  @@index([fromDate, toDate])
  @@index([sourceMode])
}

model PrepItem {
  id                  String   @id @default(cuid())
  prepListId          String
  kind                String   @default("ingredient")
  name                String
  qty                 String?
  unit                String?
  ingredientType      String?
  prepGroup           String?
  dish                String?
  notes               String?
  checked             Boolean  @default(false)
  sortOrder           Int      @default(0)
  sourceMealIdsJson   String   @default("[]")
  sourceRecipeIdsJson String   @default("[]")
  sourceLabelsJson    String   @default("[]")
  prepList            PrepList @relation(fields: [prepListId], references: [id], onDelete: Cascade)

  @@index([prepListId, sortOrder])
  @@index([prepListId, kind])
}

model UserPreference {
  id                     String   @id @default("default")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  householdSize          Int      @default(2)
  cookingLength          String   @default("weeknight")
  dietaryTags            String   @default("")
  favoriteCuisines       String   @default("")
  avoidCuisines          String   @default("")
  avoidIngredients       String   @default("[]")
  pantryStaples          String   @default("[]")
  planningNotes          String   @default("")
  nutritionTags          String   @default("")
  skillLevel             String   @default("home-cook")
  budgetRange            String   @default("moderate")
  autoGenerateGrocery    Boolean  @default(true)
  consolidateIngredients Boolean  @default(true)
  autoReviewPantry       Boolean  @default(true)
  defaultPlanLength      String   @default("7")
  groceryGrouping        String   @default("category")
  defaultRecipeView      String   @default("basic")
  defaultUnitMode        String   @default("cup")
  reasoningEffort        String   @default("")
}

model SyncState {
  key   String @id
  value String
}

model PantryItem {
  id                    String                 @id @default(cuid())
  name                  String
  normalizedName        String                 @unique
  category              String                 @default("Other")
  stockMode             String                 @default("always-available")
  warningThreshold      Float?
  warningUnit           String?
  expirationWarningDays Int?
  replenishmentTarget   Float?
  replenishmentUnit     String?
  replenishmentQuantity Float?
  dailyUsageQuantity    Float?
  dailyUsageUnit        String?
  dailyUsageWarningDays Int?
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  aliases               PantryAlias[]
  locations             PantryLocationStock[]
  packages              PantryPackage[]
  warningRules          PantryWarningRule[]
  events                PantryInventoryEvent[]

  @@index([category])
  @@index([stockMode])
  @@index([updatedAt])
}

model PantryAlias {
  id            String     @id @default(cuid())
  itemId        String
  label         String
  normalizedAlias String
  createdAt     DateTime   @default(now())
  item          PantryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, normalizedAlias])
  @@index([normalizedAlias])
}

model PantryLocationStock {
  id          String                 @id @default(cuid())
  itemId      String
  location    String                 @default("Unspecified")
  normalizedLocation String           @default("unspecified")
  quantity    Float?
  unit        String?
  approximate Boolean                @default(false)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  item        PantryItem             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  lots        PantryLot[]
  events      PantryInventoryEvent[]

  @@unique([itemId, normalizedLocation])
  @@index([normalizedLocation])
  @@index([updatedAt])
}

model PantryLot {
  id              String               @id @default(cuid())
  locationStockId String
  quantity        Float
  unit            String?
  approximate     Boolean              @default(false)
  bestBeforeAt    DateTime?
  expiresAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  locationStock   PantryLocationStock  @relation(fields: [locationStockId], references: [id], onDelete: Cascade)
  events          PantryInventoryEvent[]

  @@index([locationStockId, expiresAt])
}

model PantryPackage {
  id               String     @id @default(cuid())
  itemId           String
  label            String
  quantity         Float
  unit             String
  dimension        String
  confirmed        Boolean    @default(false)
  enabled          Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  item             PantryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, enabled])
}

model PantryWarningRule {
  id          String     @id @default(cuid())
  itemId      String
  threshold   Float
  unit        String?
  severity    String     @default("warning")
  message     String?
  enabled     Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  item        PantryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, enabled])
}

model PantryInventoryEvent {
  id              String                @id @default(cuid())
  itemId          String
  locationStockId String?
  lotId           String?
  type            String
  quantityDelta   Float?
  quantity        Float?
  unit            String?
  approximate     Boolean               @default(false)
  sourceType      String?
  sourceId        String?
  sourceIdentity  String?               @unique
  metadataJson    String                @default("{}")
  occurredAt      DateTime              @default(now())
  importedAt      DateTime?
  item            PantryItem            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationStock   PantryLocationStock?  @relation(fields: [locationStockId], references: [id], onDelete: SetNull)
  lot             PantryLot?            @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([itemId, occurredAt])
  @@index([locationStockId, occurredAt])
  @@index([type, occurredAt])
}

model Recipe {
  id           String             @id @default(cuid())
  title        String
  normalizedTitle String?         @unique
  description  String?
  servings     Int                @default(2)
  prepTime     Int?
  cookTime     Int?
  difficulty   String?
  cuisine      String?
  instructions String
  sourceUrl    String?
  normalizedSourceUrl String?     @unique
  sourceLabel  String?
  origin       String             @default("manual")
  favourite    Boolean            @default(false)
  rating       Int?
  cookNotes    String?
  lastMadeAt   DateTime?
  sourceRecipeId String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  sourceRecipe Recipe?            @relation("RecipeIteration", fields: [sourceRecipeId], references: [id], onDelete: SetNull)
  derivedRecipes Recipe[]         @relation("RecipeIteration")
  ingredients  RecipeIngredient[]
  tags         RecipeTag[]
  linkedFrom   RecipeLink[]       @relation("ParentRecipe")
  linkedTo     RecipeLink[]       @relation("SubRecipe")
  meals        Meal[]

  @@index([title])
  @@index([origin])
  @@index([cuisine])
  @@index([sourceUrl])
  @@index([sourceRecipeId])
}

model RecipeIngredient {
  id       String  @id @default(cuid())
  recipeId String
  name     String
  quantity Float?
  quantityNumerator   Int?
  quantityDenominator Int?
  unit     String?
  group    String?
  notes    String?
  parseConfidence String?
  parseRaw String?
  order    Int     @default(0)

  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId, order])
  @@index([recipeId, unit])
  @@index([name])
}

model RecipeTag {
  id       String @id @default(cuid())
  recipeId String
  tag      String

  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, tag])
  @@index([tag])
}

model RecipeLink {
  id          String @id @default(cuid())
  parentId    String
  subRecipeId String

  parent      Recipe @relation("ParentRecipe", fields: [parentId], references: [id], onDelete: Cascade)
  subRecipe   Recipe @relation("SubRecipe", fields: [subRecipeId], references: [id], onDelete: Restrict)

  @@unique([parentId, subRecipeId])
  @@index([subRecipeId])
}

